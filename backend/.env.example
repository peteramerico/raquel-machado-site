# Porta, host e porta do banco são forçados pelo docker-compose (PORT=3337, DB_HOST=mysql, DB_PORT=3306).
# Os valores abaixo valem para rodar fora do Docker (desenvolvimento).
PORT=3337

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=raquel_blog
DB_USER=raquel_app
DB_PASSWORD=trocar_senha_aqui
DB_ROOT_PASSWORD=trocar_root_senha_aqui

FRONTEND_URL=https://raquelmachadoped.com.br

# Login (Fase 1). OBRIGATÓRIO em produção: o backend NÃO sobe sem um segredo forte (32+ caracteres, sem "trocar").
# Gerar com:  openssl rand -hex 32     (trocar o valor depois derruba todas as sessões)
JWT_SECRET=trocar_por_string_aleatoria_longa_aqui

# Custo do bcrypt (padrão 12; 4 só em testes)
# BCRYPT_COST=12
